# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ─── Virtual Environment ───
.venv/
venv/
env/

# ─── Environment Variables & Secrets ───
.env
.env.*
!.env.example
.evn
.evn.*
.streamlit/secrets.toml
.streamlit/secrets.*.toml

# ─── Data (generated at runtime) ───
data/
*.db

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Testing ───
.pytest_cache/
.mypy_cache/
.coverage

# ─── API Collections ───
# Ensure the API collections are never ignored (even if they contain subfolders named 'env' or '.env' files)
!api-collection/
!api-collection/**
