# ╔══════════════════════════════════════════════════════════════╗
# ║             EduTechAI — Streamlit Cloud Secrets              ║
# ╚══════════════════════════════════════════════════════════════╝
# For Streamlit Community Cloud:
# 1. Open your app on https://share.streamlit.io
# 2. Go to "App settings" (three dots menu -> Settings) -> "Secrets"
# 3. Paste the contents of this file with your actual API keys.
#
# For Local Development (optional alternative to .env):
# Copy this file to .streamlit/secrets.toml

# ─── LLM Provider ───
LLM_PROVIDER = "groq"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
GROQ_API_KEY = "gsk_your_key_here"

# ─── Model Assignments ───
ORCHESTRATOR_MODEL = "llama-3.1-8b-instant"
SOCRATIC_TUTOR_MODEL = "llama-3.1-8b-instant"
QUIZ_AGENT_MODEL = "llama-3.1-8b-instant"

# ─── YouTube ───
YOUTUBE_API_KEY = "your_youtube_api_key_here"
YOUTUBE_MAX_RESULTS = 5
YOUTUBE_DAILY_SEARCH_LIMIT = 100

# ─── Academic APIs ───
OPENALEX_EMAIL = "your_email@example.com"
SEMANTIC_SCHOLAR_API_KEY = ""

# ─── Database ───
DATABASE_URL = "sqlite+aiosqlite:///./data/edutechai.db"
DATABASE_SCHEMA = "edutechAI"
AUTO_CREATE_TABLES = true

# ─── Vector Store ───
CHROMA_PERSIST_DIR = "./data/chroma_db"
CHROMA_COLLECTION_NAME = "youtube_transcripts"

# ─── Server ───
HOST = "127.0.0.1"
PORT = 8000
DEBUG = true

# ─── JWT Authentication & Security ───
JWT_SECRET_KEY = "D5rTsC2QeoxN3LRGPcFR6KJX5Z/SXw/J8JINJ2Kh35c="
JWT_ALGORITHM = "HS256"
JWT_EXPIRE_MINUTES = 60
