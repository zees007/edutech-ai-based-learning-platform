# ╔══════════════════════════════════════════════════════════════╗
# ║                    EduTechAI Configuration                  ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your API keys.

# ─── LLM Provider ───────────────────────────────────────────────
# Options: groq, ollama, openai_compatible
# 
# Option A: Groq Cloud (Default - Fast Cloud Inference)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_key_here
ORCHESTRATOR_MODEL=openai/gpt-oss-20b
SOCRATIC_TUTOR_MODEL=openai/gpt-oss-20b
QUIZ_AGENT_MODEL=openai/gpt-oss-20b

# Option B: Ollama (Local LLM - No API Key Needed)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# -- For Llama 3.1:
# ORCHESTRATOR_MODEL=llama3.1:8b
# SOCRATIC_TUTOR_MODEL=llama3.1:8b
# QUIZ_AGENT_MODEL=llama3.1:8b
# -- For Qwen 3.5:
# ORCHESTRATOR_MODEL=qwen3.5
# SOCRATIC_TUTOR_MODEL=qwen3.5
# QUIZ_AGENT_MODEL=qwen3.5

# Max timeout (in seconds) for LLM responses (default: 120.0 seconds)
LLM_TIMEOUT=120.0

# ─── YouTube ────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=5
YOUTUBE_DAILY_SEARCH_LIMIT=100
FREE_YOUTUBE_LIMIT=1
PRO_YOUTUBE_LIMIT=3
ULTRA_YOUTUBE_LIMIT=5

# ─── Socratic Follow-up Limits ───────────────────────────────
FREE_FOLLOWUP_LIMIT=1
PRO_FOLLOWUP_LIMIT=5

# ─── Academic APIs ──────────────────────────────────────────────
# OpenAlex: email gets you into the "polite pool" (faster rate limits)
OPENALEX_EMAIL=your_email@example.com
# Semantic Scholar: optional API key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=

OPENALEX_API_URL=https://api.openalex.org/works
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1/paper/search
ARXIV_API_URL=https://export.arxiv.org/api/query

# ─── Web Search ─────────────────────────────────────────────────
# Tavily API key for AI RAG search (optional; DuckDuckGo is used as fallback)
TAVILY_API_KEY=your_tavily_api_key_here
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=4

# ─── Database ───────────────────────────────────────────────────
# PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SCHEMA=edutechAI
# DDL behavior: Set to false in production if using migration tools like Alembic
AUTO_CREATE_TABLES=true

# ─── Vector Store ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=youtube_transcripts

# ─── Server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ─── JWT Authentication & Authorization ────────────────────────
JWT_SECRET_KEY=your_jwt_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
