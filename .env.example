# ╔══════════════════════════════════════════════════════════════╗
# ║                    EduTechAI Configuration                  ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your API keys.

# ─── LLM Provider ───────────────────────────────────────────────
# Options: groq, ollama, openai_compatible
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_key_here

# ─── Model Assignments ─────────────────────────────────────────
# Change these to swap models without touching code.
# For Groq, see available models at: https://console.groq.com/docs/models
ORCHESTRATOR_MODEL=llama-3.1-8b-instant
SOCRATIC_TUTOR_MODEL=llama-3.1-8b-instant
QUIZ_AGENT_MODEL=llama-3.1-8b-instant

# ─── YouTube ────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=5
YOUTUBE_DAILY_SEARCH_LIMIT=100

# ─── Academic APIs ──────────────────────────────────────────────
# OpenAlex: email gets you into the "polite pool" (faster rate limits)
OPENALEX_EMAIL=your_email@example.com
# Semantic Scholar: optional API key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=

# ─── Database ───────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./data/edutechai.db
# PostgreSQL (future):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edutechai

# ─── Vector Store ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=youtube_transcripts

# ─── Server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true
