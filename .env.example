# ╔══════════════════════════════════════════════════════════════╗
# ║                    EduTechAI Configuration                  ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your API keys.

# ─── LLM Provider ───────────────────────────────────────────────
# Options: groq, ollama, openai_compatible
# 
# Option A: Groq Cloud (Default - Fast Cloud Inference)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_key_here
ORCHESTRATOR_MODEL=llama-3.1-8b-instant
SOCRATIC_TUTOR_MODEL=llama-3.1-8b-instant
QUIZ_AGENT_MODEL=llama-3.1-8b-instant

# Option B: Ollama (Local LLM - No API Key Needed)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# ORCHESTRATOR_MODEL=llama3.1:8b
# SOCRATIC_TUTOR_MODEL=llama3.1:8b
# QUIZ_AGENT_MODEL=llama3.1:8b

# ─── YouTube ────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=5
YOUTUBE_DAILY_SEARCH_LIMIT=100

# ─── Academic APIs ──────────────────────────────────────────────
# OpenAlex: email gets you into the "polite pool" (faster rate limits)
OPENALEX_EMAIL=your_email@example.com
# Semantic Scholar: optional API key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=

# ─── Database ───────────────────────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./data/edutechai.db
# PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SCHEMA=edutechAI
# DDL behavior: Set to false in production if using migration tools like Alembic
AUTO_CREATE_TABLES=true

# ─── Vector Store ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=youtube_transcripts

# ─── Server ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ─── JWT Authentication & Authorization ────────────────────────
JWT_SECRET_KEY=D5rTsC2QeoxN3LRGPcFR6KJX5Z/SXw/J8JINJ2Kh35c=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
